DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_DOMAIN=localhost:8000

# Seed values for `python manage.py seed_superadmin` — never commit real values.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# AI-помічник у віджеті чату (OpenAI). Ключ не комітьте.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram-бот (створіть через @BotFather). Токен не комітьте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email (підтвердження замовлень, відновлення пароля). Без цих змінних листи
# просто друкуються в консоль сервера — зручно для розробки.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Velore <no-reply@velore.example>

# Шлях до файлу SQLite. Потрібен лише для Docker-деплою (див. docker-compose.yml).
SQLITE_PATH=
