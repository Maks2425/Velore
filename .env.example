DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_DOMAIN=localhost:8000

# Seed values for `python manage.py seed_superadmin` — never commit real values.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# AI-помічник у віджеті чату (OpenAI). Ключ не комітьте.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
